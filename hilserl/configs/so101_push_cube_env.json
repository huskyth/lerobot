{
  "env": {
    "name": "real_robot",
    "fps": 30,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79015851-if00",
      "id": "follower_arm",
      "use_degrees": true,
      "disable_torque_on_disconnect": true,
      "max_relative_target": null,
      "cameras": {
        "top": {
          "type": "opencv",
          "index_or_path": "/dev/v4l/by-id/usb-2MP_USB_Camera_2MP_USB_Camera_04434000_P120800_SN0002-video-index0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG"
        },
        "wrist": {
          "type": "opencv",
          "index_or_path": "/dev/v4l/by-id/usb-JoyandAI_JYU2C-2083_JYU2C-2083-2609096-video-index0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG"
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B8E116379-if00",
      "id": "leader_arm",
      "use_degrees": true,
      "events_enabled": true,
      "start_intervening": true,
      "hil_action_mode": "joint"
    },
    "processor": {
      "control_mode": "joint",
      "max_gripper_pos": 100.0,
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": true,
        "add_ee_pose_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": null,
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": [
          -5.1429,
          -102.2418,
          93.6703,
          63.0769,
          1.6264,
          1.7532
        ],
        "reset_time_s": 3.0,
        "control_time_s": 60.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": null,
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.5,
        "success_reward": 1.0
      }
    }
  },
  "dataset": {
    "repo_id": "huskyth/so101_push_cube_hilserl",
    "root": "/home/husky/Desktop/lerobot/data/so101_push_cube_hilserl",
    "task": "push the cube forward",
    "num_episodes_to_record": 5,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cuda"
}
