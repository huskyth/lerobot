{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/ttyACM0",
      "id": "follower_arm",
      "use_degrees": true,
      "disable_torque_on_disconnect": true,
      "max_relative_target": 10.0,
      "cameras": {
        "top": {
          "type": "opencv",
          "index_or_path": "/dev/video0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG"
        },
        "wrist": {
          "type": "opencv",
          "index_or_path": "/dev/video2",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG"
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/ttyACM1",
      "id": "leader_arm",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "max_gripper_pos": 100.0,
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": true,
        "add_ee_pose_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": null,
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": null,
        "reset_time_s": 2.5,
        "control_time_s": 30.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "/home/husky/Desktop/lerobot/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [
            0.115,
            -0.145,
            -0.0075
          ],
          "max": [
            0.26,
            0.145,
            0.1
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.009,
          "y": 0.009,
          "z": 0.01
        }
      },
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.5,
        "success_reward": 1.0
      }
    }
  },
  "dataset": {
    "repo_id": "huskyth/so101_hilserl_task",
    "root": "/home/husky/Desktop/lerobot/data/so101_hilserl_task",
    "task": "pick and place",
    "num_episodes_to_record": 20,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cuda"
}
