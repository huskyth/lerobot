{
  "output_dir": "outputs/hilserl/so101_push_cube",
  "job_name": "so101_push_cube_hilserl",
  "resume": false,
  "seed": 1000,
  "num_workers": 0,
  "batch_size": 64,
  "steps": 30000,
  "log_freq": 100,
  "save_checkpoint": true,
  "save_freq": 5000,
  "wandb": {
    "enable": false,
    "project": "so101_hilserl",
    "disable_artifact": true
  },
  "swanlab": {
    "enable": true,
    "project": "so101-hilserl",
    "workspace": null,
    "experiment_name": "so101_push_cube",
    "description": "SO101 HIL-SERL push-cube experiment",
    "tags": ["so101", "hil-serl", "push-cube"],
    "mode": "online",
    "host": null,
    "api_key_env": "SWANLAB_API_KEY",
    "public": false,
    "run_id": null,
    "resume": null
  },
  "dataset": {
    "repo_id": "local/so101_push_cube",
    "root": "data/so101_push_cube",
    "use_imagenet_stats": false
  },
  "algorithm": {
    "type": "sac",
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "temperature_lr": 0.0003,
    "discount": 0.97,
    "use_backup_entropy": true,
    "critic_target_update_weight": 0.005,
    "num_critics": 2,
    "num_subsample_critics": null,
    "critic_network_kwargs": {
      "hidden_dims": [256, 256],
      "activate_final": true,
      "final_activation": null
    },
    "discrete_critic_network_kwargs": {
      "hidden_dims": [256, 256],
      "activate_final": true,
      "final_activation": null
    },
    "temperature_init": 0.01,
    "target_entropy": null,
    "utd_ratio": 1,
    "policy_update_freq": 1,
    "grad_clip_norm": 10.0,
    "use_torch_compile": false
  },
  "mixer": "online_offline",
  "online_ratio": 0.5,
  "policy": {
    "type": "gaussian_actor",
    "push_to_hub": false,
    "n_obs_steps": 1,
    "normalization_mapping": {
      "VISUAL": "MEAN_STD",
      "STATE": "MIN_MAX",
      "ENV": "MIN_MAX",
      "ACTION": "MIN_MAX"
    },
    "input_features": {
      "observation.images.top": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [6]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [3]
      }
    },
    "dataset_stats": {
      "observation.images.top": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225]
      },
      "observation.images.wrist": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225]
      },
      "observation.state": {
        "min": [-180.0, -180.0, -180.0, -180.0, -180.0, 0.0],
        "max": [180.0, 180.0, 180.0, 180.0, 180.0, 100.0]
      },
      "action": {
        "min": [-1.0, -1.0, -1.0],
        "max": [1.0, 1.0, 1.0]
      }
    },
    "num_discrete_actions": 3,
    "device": "cuda",
    "storage_device": "cpu",
    "use_amp": false,
    "vision_encoder_name": "lerobot/resnet10",
    "freeze_vision_encoder": true,
    "image_encoder_hidden_dim": 32,
    "shared_encoder": true,
    "online_steps": 30000,
    "online_buffer_capacity": 20000,
    "offline_buffer_capacity": 10000,
    "online_step_before_learning": 200,
    "state_encoder_hidden_dim": 256,
    "latent_dim": 64,
    "actor_network_kwargs": {
      "hidden_dims": [256, 256],
      "activate_final": true
    },
    "policy_kwargs": {
      "use_tanh_squash": true,
      "std_min": 1e-5,
      "std_max": 10.0,
      "init_final": 0.05
    },
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 2
    },
    "concurrency": {
      "actor": "threads",
      "learner": "threads"
    },
    "repo_id": null
  },
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "fps": 10,
    "task": "push cube to goal",
    "robot": {
      "type": "so101_follower",
      "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79015851-if00",
      "id": "follower_arm",
      "use_degrees": true,
      "max_relative_target": 5.0,
      "cameras": {
        "top": {
          "type": "opencv",
          "index_or_path": "/dev/video2",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG"
        },
        "wrist": {
          "type": "opencv",
          "index_or_path": "/dev/video0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "fourcc": "MJPG"
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B8E116379-if00",
      "id": "leader_arm",
      "use_degrees": true,
      "leader_follower_mode": true,
      "leader_follow_max_step_deg": 2.0
    },
    "processor": {
      "control_mode": "leader",
      "max_gripper_pos": 100.0,
      "observation": {
        "display_cameras": false,
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "add_ee_pose_to_observation": false
      },
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [128, 128]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "fixed_reset_joint_positions": [-6.198, -101.626, 96.659, 71.868, -4.264, 2.094],
        "pre_reset_delay_s": 3.0,
        "reset_time_s": 5.0,
        "control_time_s": 60.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "rl/assets/so101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [0.115, -0.145, -0.03],
          "max": [0.26, 0.145, 0.1]
        },
        "end_effector_step_sizes": {
          "x": 0.009,
          "y": 0.009,
          "z": 0.01
        }
      },
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.5,
        "success_reward": 1.0
      }
    },
    "features": {
      "observation.images.top": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [3, 128, 128]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [6]
      },
      "action": {
        "type": "ACTION",
        "shape": [3]
      }
    },
    "features_map": {
      "observation.images.top": "observation.images.top",
      "observation.images.wrist": "observation.images.wrist",
      "observation.state": "observation.state",
      "action": "action"
    }
  }
}
